{
  "epochs": 100,
  "batch_size": 32,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "monitor": "macro_f1",
  "early_stopping": true,
  "patience": 15,
  "delta": 0.0001,
  "cache_audio": false,
  "num_workers": -1,
  "pin_memory": true,
  "threshold": 0.5,
  "use_pos_weight": true,
  "max_pos_weight": 20.0,
  "random_seed": 2026,
  "ckpt_dir": "checkpoint",
  "profile_model": false,
  "snr_bands": [
    { "name": "[-5,0]", "min_db": -5.0, "max_db": 0.0 },
    { "name": "[5,10]", "min_db": 5.0, "max_db": 10.0 },
    { "name": "[15,20]", "min_db": 15.0, "max_db": 20.0 }
  ],
  "model": {
    "backbone": "Cnn14MobileV2",
    "pretrained": false,
    "classes_num": 21
  },
  "dataset_splitter": {
    "dataset_path": "/marimo/21_labels_dataset",
    "signal_type": "mixture",
    "train_directory": "train_single",
    "validation_directory": "validation_single",
    "test_directory": "test_single",
    "selected_labels_file": "selected_labels.csv",
    "use_predefined_splits": true,
    "include_video": false,
    "save_results": false,
    "seed": 2026,
    "split_strategy": "predefined_manifest",
    "evaluation_mode": "holdout",
    "dynamic_snr_enabled": true,
    "dynamic_snr_probability": 0.5,
    "dynamic_snr_min_db": -5.0,
    "dynamic_snr_max_db": 20.0,
    "dynamic_snr_control_seconds": 0.5
  },
  "audio_features": {
    "sample_rate": 16000,
    "clip_seconds": 4.0,
    "inference_hop_seconds": 2.0,
    "window_size": 512,
    "hop_size": 160,
    "mel_bins": 128,
    "fmin": 20,
    "fmax": 8000,
    "time_drop_width": 64,
    "time_stripes_num": 2,
    "freq_drop_width": 8,
    "freq_stripes_num": 2
  }
}
